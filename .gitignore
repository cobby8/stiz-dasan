# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.env*.local

# 임시 작업물 / 개인정보 포함 가능 — 절대 커밋 금지
.tmp/
.__unlinktest
/public/uploads/

# 대사 리포트 — 원생 이름 포함, 커밋 금지
outputs/reconcile/
