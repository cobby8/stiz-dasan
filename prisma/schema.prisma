generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String                        @id @default(uuid())
  email                       String                        @unique
  username                    String?
  name                        String
  phone                       String?
  phoneVerifiedAt             DateTime?                     @db.Timestamptz(6)
  authUserId                  String?                       @unique
  role                        Role                          @default(PARENT)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  classes                     Class[]
  students                    Student[]
  coach                       Coach?
  drivenShuttleRoutePlans     ShuttleRoutePlan[]            @relation("ShuttleRouteDriver")
  enrollmentApplications      EnrollmentApplication[]       @relation("EnrollmentApplicationParent")
  parentOperationsLinks       ParentOperationsRequestLink[] @relation("ParentOperationsLinkCreator")
  regularLocationLinksCreated RegularShuttleLocationLink[]  @relation("RegularLocationLinkCreator")
  regularLocationLinksParent  RegularShuttleLocationLink[]  @relation("RegularLocationLinkParent")
  operationsAuditLogs         OperationsAuditLog[]          @relation("OperationsAuditActor")
  operationsRequested         OperationsRequest[]           @relation("OperationsRequestRequester")
  operationsApproved          OperationsRequest[]           @relation("OperationsRequestApprover")
  kakaoParentIdentities       KakaoParentIdentity[]
}

/// 카카오 챗봇 사용자를 최초 1회 인증된 학부모 계정에 연결한다.
/// 카카오 user key 원문은 저장하지 않고 서버 비밀키로 만든 HMAC 해시만 보관한다.
model KakaoParentIdentity {
  id            String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  botId         String
  userKeyHash   String
  parentUserId  String?
  status        String              @default("PENDING") // PENDING | ACTIVE | REVOKED
  linkTokenHash String?             @unique
  linkExpiresAt DateTime?           @db.Timestamptz(6)
  linkedAt      DateTime?           @db.Timestamptz(6)
  revokedAt     DateTime?           @db.Timestamptz(6)
  lastSeenAt    DateTime            @default(now()) @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  parent        User?               @relation(fields: [parentUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  intakes       KakaoParentIntake[]

  @@unique([botId, userKeyHash])
  @@index([parentUserId, status])
}

/// 카카오 대화 원문과 구조화된 해석을 분리해 보존하는 접수 원장.
/// APPLIED는 기존 결석/셔틀 검증 함수를 통과한 경우에만 사용한다.
model KakaoParentIntake {
  id                  String                   @id @default(dbgenerated("(gen_random_uuid())::text"))
  identityId          String
  studentId           String?
  kind                String
  sourceText          String
  structuredJson      Json?
  status              String                   @default("DRAFT") // DRAFT | NEEDS_DETAILS | SUBMITTED | APPLIED | HELD | FAILED | CANCELED
  idempotencyKey      String                   @unique
  providerRequestId   String?
  confirmedAt         DateTime?                @db.Timestamptz(6)
  appliedAt           DateTime?                @db.Timestamptz(6)
  errorCode           String?
  decidedByUserId     String?
  decidedAt           DateTime?                @db.Timestamptz(6)
  decisionNote        String?
  operationsRequestId String?                  @unique
  createdAt           DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  identity            KakaoParentIdentity      @relation(fields: [identityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  audits              KakaoParentIntakeAudit[]

  @@unique([identityId, providerRequestId])
  @@index([identityId, status, createdAt(sort: Desc)])
  @@index([studentId, createdAt(sort: Desc)])
}

/// 관리자가 카카오 접수를 검토한 이력. 외부 발송 없이 내부 판단만 감사 가능하게 남긴다.
model KakaoParentIntakeAudit {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  intakeId    String
  action      String
  actorUserId String
  fromStatus  String
  toStatus    String
  note        String?
  detailsJson Json?
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  intake      KakaoParentIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([intakeId, createdAt(sort: Desc)])
}

model ParentAccountClaim {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  parentId            String
  applicationId       String?
  invoiceId           String?
  tokenHash           String    @unique
  phoneHash           String
  status              String    @default("PENDING")
  expiresAt           DateTime  @db.Timestamptz(6)
  otpHash             String?
  otpExpiresAt        DateTime? @db.Timestamptz(6)
  otpSentAt           DateTime? @db.Timestamptz(6)
  otpAttempts         Int       @default(0)
  lockedAt            DateTime? @db.Timestamptz(6)
  verifiedAt          DateTime? @db.Timestamptz(6)
  proofHash           String?
  proofExpiresAt      DateTime? @db.Timestamptz(6)
  consumedAt          DateTime? @db.Timestamptz(6)
  authUserId          String?
  processingAt        DateTime? @db.Timestamptz(6)
  processingAttemptId String?
  redirectPath        String    @default("/mypage")
  lastError           String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([parentId, status, createdAt])
  @@index([phoneHash, createdAt])
  @@index([applicationId])
  @@index([invoiceId])
}

model ParentAccountClaimOtpSend {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  claimId   String
  phoneHash String
  status    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([claimId, createdAt])
  @@index([phoneHash, createdAt])
}

model Student {
  id                       String                        @id @default(uuid())
  name                     String
  birthDate                DateTime
  gender                   String?
  memo                     String?
  parentId                 String
  branch                   String? // 지점 원본값 (예: "2호점 : 행정복지센터...")
  phone                    String? // 학생 휴대폰번호
  school                   String? // 학교명
  grade                    String? // 학년 (예: "2026년 초등 5학년")
  address                  String? // 주소
  enrollDate               DateTime? // 입회일자
  referralSource           String? // 가입경로 (예: "지인소개", "네이버", "전단지" 등)
  uniformStatus            String? // 유니폼 상태 (예: "수령완료", "미수령", "추가주문" 등)
  basketballExp            String? // 농구 경험
  hopeNote                 String? // 바라는 점
  agreementsJSON           String                        @default("{}") // 개인정보/이용약관/주의사항 동의 원본
  sourceImportRowId        String? // 마지막 시트 이관 원본 행
  // 학생 병합: 흡수된 쪽 행은 지우지 않고 여기에 대표 학생 id를 찍는다.
  // DB에는 있는데 이 파일에 빠져 있어, ORM으로 조회하는 화면이 통째로 죽었다
  // (2026-08-09 학부모 마이페이지). 스키마 파일은 DB의 사본이어야 한다.
  // 참고: DB의 인덱스는 부분 인덱스(WHERE ... IS NOT NULL)라 Prisma로 표현할 수
  // 없어 @@index를 두지 않는다. 여기에 일반 인덱스를 적으면 반대 방향으로 어긋난다.
  mergedIntoStudentId      String?
  mergedAt                 DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  attendances              Attendance[]
  enrollments              Enrollment[]
  guardians                Guardian[]
  payments                 Payment[]
  sessionNotes             StudentSessionNote[]
  importRawRows            StudentSheetRawRow[]
  registrationLedgers      StudentRegistrationLedger[]
  shuttleRides             StudentShuttleRide[]
  shuttleRoutePassengers   ShuttleRoutePassenger[]
  shuttleLocations         StudentShuttleLocation[]
  teamRosterEntries        StudentTeamRosterEntry[]
  regularAbsences          RegularAbsence[] // 정규 수업 사전 결석 신고(back-relation)
  enrollmentChangeRequests EnrollmentChangeRequest[]
  paymentParentRequests    PaymentParentRequest[]
  shuttleDayExceptions     ShuttleDayException[]
  parentOperationsLinks    ParentOperationsRequestLink[]
  operationsCommands       OperationsCommand[]
  regularShuttleStops      RegularShuttleStop[]
  regularLocationLinks     RegularShuttleLocationLink[]
  parent                   User                          @relation(fields: [parentId], references: [id])

  @@index([parentId])
  @@index([name, parentId])
  @@index([branch])
  @@index([sourceImportRowId])
}

model ParentOperationsRequestLink {
  id              String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId       String
  tokenHash       String               @unique
  purpose         String               @default("GENERAL") // GENERAL | KAKAO_RECONFIRMATION
  expiresAt       DateTime             @db.Timestamptz(6)
  revokedAt       DateTime?            @db.Timestamptz(6)
  lastUsedAt      DateTime?            @db.Timestamptz(6)
  createdByUserId String
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy       User                 @relation("ParentOperationsLinkCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requests        OperationsRequest[]
  auditLogs       OperationsAuditLog[]

  @@index([studentId, expiresAt])
}

model OperationsRequest {
  id                  String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  sourceText          String
  targetMonth         String
  status              String                       @default("DRAFT")
  requestedByUserId   String
  approvedByUserId    String?
  approvedAt          DateTime?                    @db.Timestamptz(6)
  parentRequestLinkId String?
  submittedAt         DateTime?                    @db.Timestamptz(6)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  parentRequestLink   ParentOperationsRequestLink? @relation(fields: [parentRequestLinkId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  requestedBy         User                         @relation("OperationsRequestRequester", fields: [requestedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy          User?                        @relation("OperationsRequestApprover", fields: [approvedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  commands            OperationsCommand[]
  auditLogs           OperationsAuditLog[]

  @@index([status, createdAt(sort: Desc)])
}

model OperationsAuditLog {
  id          String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  requestId   String?
  linkId      String?
  action      String
  actorType   String
  actorUserId String?
  detailsJson Json?
  createdAt   DateTime                     @default(now()) @db.Timestamptz(6)
  request     OperationsRequest?           @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  link        ParentOperationsRequestLink? @relation(fields: [linkId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actor       User?                        @relation("OperationsAuditActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestId, createdAt(sort: Desc)])
}

/// 시트·랠리즈·홈페이지에 반영할 한 개의 구조화된 변경 명령.
/// 운영 경로는 PgBouncer 호환 raw SQL을 사용하지만 FK 관계도 실제 DB와 같게 선언한다.
model OperationsCommand {
  id                 String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  requestId          String
  idempotencyKey     String                  @unique
  sourceText         String
  studentId          String?
  studentName        String?
  kind               String
  effectiveMonth     String
  confidence         String
  status             String                  @default("PENDING")
  holdReason         String?
  beforeJson         Json?
  afterJson          Json?
  billingStatus      String                  @default("HELD")
  notificationStatus String                  @default("HELD")
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @db.Timestamptz(6)
  request            OperationsRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student            Student?                @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  syncAttempts       OperationsSyncAttempt[]

  @@index([requestId])
  @@index([studentId])
}

/// 외부 대상별 실행 결과. processingToken은 외부 호출 동안 동시 실행을 막는 만료형 임대다.
model OperationsSyncAttempt {
  id                  String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  commandId           String
  target              String
  status              String            @default("PENDING")
  attempts            Int               @default(0)
  externalReference   String?
  error               String?
  verifiedAt          DateTime?         @db.Timestamptz(6)
  processingToken     String?
  processingStartedAt DateTime?         @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @db.Timestamptz(6)
  command             OperationsCommand @relation(fields: [commandId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([commandId, target])
  @@index([commandId])
}

model Program {
  id                 String              @id @default(uuid())
  name               String
  targetAge          String?
  frequency          String?
  description        String?
  price              Int
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  order              Int                 @default(0)
  days               String?
  priceWeek1         Int?
  priceWeek2         Int?
  priceWeek3         Int?
  priceDaily         Int?
  shuttleFeeOverride Int?
  weeklyFrequency    String?
  imageUrl           String?
  runsShuttle        Boolean             @default(true)
  deletedAt          DateTime?
  classes            Class[]
  slotOverrides      ClassSlotOverride[]
  customClassSlots   CustomClassSlot[]
  scheduleSlots      ScheduleSlot[]
}

model Class {
  id                 String                    @id @default(uuid())
  programId          String
  instructorId       String?
  name               String
  dayOfWeek          String
  startTime          String
  endTime            String
  location           String?
  capacity           Int
  slotKey            String?                   @unique // 시간표 슬롯과 연결 (예: "Mon-3", "custom-uuid")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  instructor         User?                     @relation(fields: [instructorId], references: [id])
  program            Program                   @relation(fields: [programId], references: [id])
  enrollments        Enrollment[]
  sessions           Session[]
  regularAbsences    RegularAbsence[] // 정규 수업 사전 결석 신고(back-relation)
  changeRequestsFrom EnrollmentChangeRequest[] @relation("EnrollmentChangeFromClass")
  changeRequestsTo   EnrollmentChangeRequest[] @relation("EnrollmentChangeToClass")

  @@index([programId])
  @@index([instructorId])
}

/// 학생의 한 달 장부. 기존 Enrollment/Payment나 시트를 자동 변경하지 않는다.
model MonthlyEnrollmentRegister {
  id          String                              @id @default(uuid())
  studentId   String
  month       String
  version     Int                                 @default(1)
  status      String                              @default("DRAFT")
  /// 반별 기간·금액·감면 근거와 학생 월 단위 셔틀비의 명시적 스냅샷.
  payload     Json
  updatedBy   String
  updatedAt   DateTime                            @default(now()) @db.Timestamptz(6)
  confirmedAt DateTime?                           @db.Timestamptz(6)
  revisions   MonthlyEnrollmentRegisterRevision[]

  @@unique([studentId, month])
  @@index([month, status])
}

/// 수정 전후 버전을 남기는 감사 기록. 확정 해제도 기존 버전을 지우지 않는다.
model MonthlyEnrollmentRegisterRevision {
  id          String                    @id @default(uuid())
  registerId  String
  studentId   String
  month       String
  version     Int
  status      String
  payload     Json
  action      String
  reason      String
  actorUserId String
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  register    MonthlyEnrollmentRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)

  @@unique([registerId, version])
  @@index([studentId, month, version])
}

model Enrollment {
  id             String                    @id @default(uuid())
  studentId      String
  classId        String
  status         String                    @default("ACTIVE")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  class          Class                     @relation(fields: [classId], references: [id])
  student        Student                   @relation(fields: [studentId], references: [id])
  changeRequests EnrollmentChangeRequest[]

  @@unique([studentId, classId])
  @@index([classId, status])
  @@index([createdAt])
  @@index([status, updatedAt])
}

/// 학부모의 수강 변경 신청(반 변경·휴원·퇴원) → 원장 승인 → 실제 반영.
/// 예전에는 "학원에 요청하기" 메모로 받아 사람이 손으로 처리했다.
/// 참고: "진행 중(PENDING)은 수강 등록당 한 건"은 DB 쪽 부분 유니크 인덱스로 막는다.
/// Prisma 로는 부분 인덱스를 표현할 수 없어 여기에 적지 않는다(적으면 반대로 어긋난다).
model EnrollmentChangeRequest {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId         String
  /// 대상 수강 등록. 반 변경·휴원·퇴원 모두 "지금 다니는 반"이 출발점이다.
  enrollmentId      String?
  /// 승인 시점에 반이 바뀌어 있어도 신청 당시를 알 수 있게 남기는 스냅샷.
  fromClassId       String?
  /// 반 변경일 때만 채운다.
  toClassId         String?
  kind              String // CLASS_CHANGE | PAUSE | WITHDRAW
  effectiveFrom     DateTime  @db.Date
  /// 휴원 복귀 예정일(선택).
  resumeOn          DateTime? @db.Date
  reason            String?
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELED
  /// 신청 당시 희망 반이 만석이었는지. 원장이 대기 건을 알아볼 수 있게 남긴다.
  waitlisted        Boolean   @default(false)
  requestedByUserId String
  decidedByUserId   String?
  decidedAt         DateTime? @db.Timestamptz(6)
  decisionNote      String?
  /// 발행한 차액 청구서. 두 번 누르면 같은 금액이 두 번 청구되므로 여기로 막는다.
  invoicedPaymentId String?
  /// 실제로 반이 옮겨진 시각. 승인은 "예약"이고 적용일이 되어야 크론이 반영한다.
  /// 참고: "적용할 것"을 찾는 DB 인덱스는 부분 인덱스라 여기에 적지 않는다.
  appliedAt         DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  student    Student     @relation(fields: [studentId], references: [id])
  enrollment Enrollment? @relation(fields: [enrollmentId], references: [id])
  fromClass  Class?      @relation("EnrollmentChangeFromClass", fields: [fromClassId], references: [id])
  toClass    Class?      @relation("EnrollmentChangeToClass", fields: [toClassId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([studentId])
}

model Session {
  id                          String                     @id @default(uuid())
  classId                     String
  date                        DateTime
  specialProgramSessionDateId String?                    @unique
  sessionKey                  String?                    @unique // 같은 반·날짜의 수업 중복 생성을 막는 키
  status                      String                     @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  notes                       String?
  topic                       String? // 수업 주제 (예: "드리블 연습")
  plannedContent              String? // 수업 전에 작성한 예정 수업 내용
  content                     String? // 수업 중 실제로 진행한 내용
  photosJSON                  String? // 수업 사진 URL 배열 (JSON 문자열로 저장)
  coachId                     String? // 담당 코치 ID (Coach 테이블 참조용, FK 없음)
  startedAt                   DateTime?                  @db.Timestamptz(6) // 실제 수업 시작 시각
  endedAt                     DateTime?                  @db.Timestamptz(6) // 실제 수업 종료 시각
  startedByUserId             String? // 수업 시작을 확인한 User ID
  endedByUserId               String? // 수업 종료를 확인한 User ID
  published                   Boolean                    @default(false) // 학부모 공개 여부 (true일 때만 학부모가 열람 가능)
  publishedAt                 DateTime? // 발행 시각 (published=true로 변경된 시점)
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  attendances                 Attendance[]
  shuttleRoutePassengers      ShuttleRoutePassenger[]
  studentNotes                StudentSessionNote[]
  class                       Class                      @relation(fields: [classId], references: [id])
  specialProgramSessionDate   SpecialProgramSessionDate? @relation(fields: [specialProgramSessionDateId], references: [id], onDelete: Restrict)

  @@index([classId, date])
  @@index([status, date])
  @@index([startedAt])
  @@index([published, date])
}

model Attendance {
  id              String    @id @default(uuid())
  sessionId       String
  studentId       String
  status          String
  note            String?
  checkedAt       DateTime? @db.Timestamptz(6) // 출결 상태를 처음 확인한 시각
  arrivedAt       DateTime? @db.Timestamptz(6) // 지각생이 실제로 도착한 시각
  checkedByUserId String? // 출결을 처리한 User ID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  session         Session   @relation(fields: [sessionId], references: [id])
  student         Student   @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

// 학생별 수업 개별 코멘트 — 세션 리포트에서 학생마다 작성하는 메모
model StudentSessionNote {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId String
  studentId String
  note      String // 코치가 작성하는 개별 코멘트 (예: "드리블 실력 많이 향상됨")
  rating    Int? // 수업 참여도/성과 점수 (1~5, 선택사항)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  session   Session  @relation(fields: [sessionId], references: [id])
  student   Student  @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Payment {
  id                 String                 @id @default(uuid())
  studentId          String
  classId            String?
  amount             Int
  status             String
  dueDate            DateTime
  paidDate           DateTime?
  type               String                 @default("MONTHLY") // MONTHLY(월 수강료), SHUTTLE(셔틀), UNIFORM(유니폼), OTHER(기타)
  method             String? // 결제수단: RALLYZ(랠리즈), CARD(카드), CASH(현금영수증), UNPAID(미결제)
  description        String? // 청구 항목 설명 (예: "4월 수강료")
  month              Int? // 청구 대상 월 (1~12)
  year               Int? // 청구 대상 연도
  autoGenerated      Boolean                @default(false) // 자동 생성 여부 (Cron/일괄 생성 구분)
  notifiedAt         DateTime? // 미납 알림 발송 시각
  invoiceNo          String?
  issuedAt           DateTime?              @db.Timestamptz(6)
  payableUntil       DateTime?              @db.Timestamptz(6)
  paidProvider       String?
  providerOrderId    String?
  providerPaymentKey String?
  receiptUrl         String?
  paymentRequestedAt DateTime?              @db.Timestamptz(6)
  lastReminderAt     DateTime?              @db.Timestamptz(6)
  reminderCount      Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  student            Student                @relation(fields: [studentId], references: [id])
  invoice            PaymentInvoice?
  transactions       PaymentTransaction[]
  auditLogs          PaymentAuditLog[]
  parentRequests     PaymentParentRequest[]

  @@unique([id, classId])
  @@index([year, month])
  @@index([status])
  @@index([studentId, year, month])
  @@index([studentId, dueDate])
  @@index([classId, status, dueDate])
  @@index([dueDate])
  @@index([status, dueDate])
  @@index([providerOrderId])
  @@index([providerPaymentKey])
}

model UniformOrder {
  id                String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  partnerRequestId  String             @unique
  parentName        String
  parentPhone       String
  parentPhoneDigits String
  customerMemo      String?
  itemSignature     String
  orderStatus       String             @default("RECEIVED") // RECEIVED | CANCELED
  stizSyncStatus    String             @default("PENDING") // PENDING | SENDING | SENT | DUPLICATE | RETRY_WAIT | NEEDS_REVIEW | SETUP_REQUIRED
  stizOrderNumber   String?
  stizDuplicate     Boolean            @default(false)
  stizMessage       String?
  sendAttempts      Int                @default(0)
  nextRetryAt       DateTime?          @db.Timestamptz(6)
  lastError         String?
  lastSentAt        DateTime?          @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  items             UniformOrderItem[]

  @@index([createdAt])
  @@index([stizSyncStatus, nextRetryAt])
  @@index([parentPhoneDigits, createdAt])
}

model UniformOrderItem {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  uniformOrderId String
  studentName    String
  design         String?
  initials       String?
  backNumber     String?
  topSize        String?
  bottomSize     String?
  quantity       Int          @default(1)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  order          UniformOrder @relation(fields: [uniformOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([uniformOrderId])
  @@index([studentName])
}

/// 학부모의 청구서 관련 요청: "입금했어요"(확인 요청)와 "영수증 주세요".
/// 지금까지는 문자로 받아 원장이 통장을 확인하고 손으로 납부 처리했다.
/// 참고: "같은 청구서·같은 종류의 대기 요청은 한 건"은 DB 부분 유니크 인덱스로 막는다.
/// Prisma 로는 부분 인덱스를 표현할 수 없어 여기에 적지 않는다.
model PaymentParentRequest {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  paymentId         String
  studentId         String
  requestedByUserId String
  kind              String // PAYMENT_CLAIM | RECEIPT
  /// 입금 확인용: 원장이 통장·랠리즈에서 대조할 단서
  paidOn            DateTime? @db.Date
  method            String? // TRANSFER | RALLYZ | CARD | CASH
  depositorName     String?
  /// 영수증용
  receiptType       String? // CASH_RECEIPT | EXPENSE_PROOF
  receiptTarget     String?
  note              String?
  status            String    @default("PENDING") // PENDING | DONE | REJECTED | CANCELED
  decidedByUserId   String?
  decidedAt         DateTime? @db.Timestamptz(6)
  decisionNote      String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([paymentId])
}

/// 학부모가 "오늘만" 셔틀을 바꾸는 것: 안 타거나, 다른 곳에서 타거나.
/// 결석과 다르다 — 아이는 수업에 온다. 기사님 화면에서도 다른 배지로 보인다.
/// 결석 신고처럼 승인 없이 바로 반영하고 원장에게는 알림만 보낸다.
/// 참고: "같은 학생·날짜·방향에 살아있는 예외는 한 건"은 DB 부분 유니크로 막는다.
model ShuttleDayException {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId         String
  serviceDate       DateTime  @db.Date
  direction         String // PICKUP | DROPOFF | BOTH
  kind              String // SKIP | LOCATION
  /// kind=LOCATION 일 때 기사님이 읽을 장소. 좌표가 아니라 사람이 읽는 글이다.
  location          String?
  note              String?
  requestedByUserId String
  canceledAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

model PaymentInvoice {
  id             String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  paymentId      String               @unique
  studentId      String
  classId        String?
  parentId       String?
  invoiceNo      String               @unique
  status         String               @default("ISSUED")
  amount         Int
  title          String
  description    String?
  dueDate        DateTime             @db.Timestamptz(6)
  issuedAt       DateTime             @default(now()) @db.Timestamptz(6)
  sentAt         DateTime?            @db.Timestamptz(6)
  paidAt         DateTime?            @db.Timestamptz(6)
  canceledAt     DateTime?            @db.Timestamptz(6)
  lastReminderAt DateTime?            @db.Timestamptz(6)
  reminderCount  Int                  @default(0)
  checkoutUrl    String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  payment        Payment              @relation(fields: [paymentId], references: [id])
  transactions   PaymentTransaction[]
  auditLogs      PaymentAuditLog[]

  @@index([parentId, status])
  @@index([studentId, dueDate])
  @@index([classId, status, dueDate])
}

model PaymentTransaction {
  id             String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  paymentId      String
  invoiceId      String
  studentId      String
  parentId       String?
  provider       String            @default("TOSS")
  orderId        String            @unique
  paymentKey     String?           @unique
  orderName      String
  amount         Int
  status         String            @default("READY")
  method         String?
  receiptUrl     String?
  failureCode    String?
  failureMessage String?
  requestedAt    DateTime          @default(now()) @db.Timestamptz(6)
  approvedAt     DateTime?         @db.Timestamptz(6)
  rawResponse    Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  payment        Payment           @relation(fields: [paymentId], references: [id])
  invoice        PaymentInvoice    @relation(fields: [invoiceId], references: [id])
  auditLogs      PaymentAuditLog[]

  @@index([invoiceId, status])
  @@index([paymentId, status])
}

model PaymentWebhookEvent {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  provider    String    @default("TOSS")
  eventId     String?
