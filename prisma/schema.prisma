  code        String    @unique
  trialLeadId String
  targetPath  String    @default("/apply/enroll")
  isActive    Boolean   @default(true)
  expiresAt   DateTime  @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  trialLead   TrialLead @relation(fields: [trialLeadId], references: [id], onDelete: Cascade)

  @@index([trialLeadId, isActive, expiresAt])
  @@index([expiresAt])
}

// 대기자 관리 — 반 정원 초과 시 대기열에 등록, 자리 생기면 제안/수락/거절 처리
model Waitlist {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId String
  classId   String
  priority  Int       @default(0) // 우선순위 (낮을수록 먼저, 자동 증가)
  status    String    @default("WAITING") // WAITING, OFFERED, ENROLLED, CANCELLED
  offeredAt DateTime? @db.Timestamptz(6) // 자리 제안 시각
  respondBy DateTime? @db.Timestamptz(6) // 응답 기한 (offeredAt + 3일)
  memo      String? // 관리자 메모
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([studentId, classId])
  @@index([classId, status])
  @@index([classId, priority, createdAt])
}

// 보강/메이크업 수업 예약 — 결석 시 다른 반에서 보충 수업을 받는 기록
model MakeupSession {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId       String
  originalClassId String // 원래 수강 중인 반 ID
  originalDate    DateTime @db.Timestamptz(6) // 결석한 날짜
  makeupClassId   String // 보강 받을 반 ID
  makeupDate      DateTime @db.Timestamptz(6) // 보강 수업 날짜
  status          String   @default("BOOKED") // BOOKED, ATTENDED, CANCELLED, NO_SHOW
  requestId       String? // 학부모 결석 요청 ID (ParentRequest 연결, 선택)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([studentId])
  @@index([makeupClassId, makeupDate])
  @@index([createdAt])
  @@index([status, createdAt])
}

// 기술 카테고리 마스터 — 드리블, 슈팅, 패스 등 평가 항목을 관리
model SkillCategory {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  name        String
  icon        String?
  order       Int      @default(0)
  maxLevel    Int      @default(5)
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// 원생별 기술 기록 — 코치가 원생의 카테고리별 레벨을 평가한 이력
model SkillRecord {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId  String
  categoryId String
  level      Int
  assessedBy String
  assessedAt DateTime @default(now()) @db.Timestamptz(6)
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([studentId, categoryId])
  @@index([assessedAt])
}

// 수강 신청서 — 구글폼 대신 자체 수강 신청 접수 (Phase B)
model EnrollmentApplication {
  id                            String                     @id @default(dbgenerated("(gen_random_uuid())::text"))
  trialLeadId                   String? // TrialLead 연결 (체험 거친 경우, null=직접 수강)
  // 아이 정보
  childName                     String
  childBirthDate                DateTime                   @db.Timestamptz(6)
  childGender                   String?
  childGrade                    String?
  childSchool                   String?
  childPhone                    String?
  // 보호자 정보
  parentName                    String
  parentPhone                   String
  parentUserId                  String?
  parentUser                    User?                      @relation("EnrollmentApplicationParent", fields: [parentUserId], references: [id], onDelete: SetNull)
  accountHandoffs               EnrollmentAccountHandoff[]
  parentRelation                String? // 부/모/기타
  address                       String?
  // 수강 정보
  enrollmentMonths              String? // Google Form: 수강신청 월, 콤마 구분
  preferredSlotKeys             String? // 콤마 구분 "Mon-4,Wed-6"
  assignedClassId               String? // 관리자 배정 반
  // 부가 정보
  basketballExp                 String? // 농구 경험 (없음/1년 미만/1~3년/3년 이상)
  uniformSize                   String?
  shuttleNeeded                 Boolean                    @default(false)
  shuttlePickup                 String?
  shuttleTime                   String? // 셔틀 희망 시간 (예: "15:30")
  shuttleDropoff                String? // 셔틀 하차 장소 (예: "다산자이 정문")
  shuttlePickupAddress          String?
  shuttlePickupRoadAddress      String?
  shuttlePickupLatitude         Float?
  shuttlePickupLongitude        Float?
  shuttlePickupPlaceId          String?
  shuttlePickupSource           String?
  shuttlePickupAccuracyMeters   Float?
  shuttlePickupConfirmedAt      DateTime?                  @db.Timestamptz(6)
  shuttleDropoffAddress         String?
  shuttleDropoffRoadAddress     String?
  shuttleDropoffLatitude        Float?
  shuttleDropoffLongitude       Float?
  shuttleDropoffPlaceId         String?
  shuttleDropoffSource          String?
  shuttleDropoffAccuracyMeters  Float?
  shuttleDropoffConfirmedAt     DateTime?                  @db.Timestamptz(6)
  shuttleLocationConsentVersion String?
  shuttleLocationConsentAt      DateTime?                  @db.Timestamptz(6)
  paymentMethod                 String?
  referralSource                String?
  memo                          String?
  // 동의
  agreedTerms                   Boolean                    @default(false)
  agreedPrivacy                 Boolean                    @default(false)
  applicationNoticeConfirmed    Boolean                    @default(false) // Google Form: 수강신청확정 안내 확인
  shuttleNoticeConfirmed        Boolean                    @default(false) // Google Form: 셔틀 주의사항 확인
  // 처리 상태
  status                        String                     @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  processedAt                   DateTime?                  @db.Timestamptz(6)
  processedNote                 String?
  convertedStudentId            String?
  // 타임스탬프
  createdAt                     DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([trialLeadId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([parentUserId])
}

model EnrollmentAccountHandoff {
  id                      String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  enrollmentApplicationId String
  tokenHash               String                @unique
  phoneHash               String
  expiresAt               DateTime              @db.Timestamptz(6)
  consumedAt              DateTime?             @db.Timestamptz(6)
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  enrollmentApplication   EnrollmentApplication @relation(fields: [enrollmentApplicationId], references: [id], onDelete: Cascade)

  @@index([enrollmentApplicationId, expiresAt])
}

// 체험/수강신청 상담·연락 기록 — 한 신청 건에 여러 연락 이력을 남긴다
model ApplicationContactLog {
  id                      String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  targetType              String // TRIAL, ENROLL
  trialLeadId             String?
  enrollmentApplicationId String?
  action                  String // CONTACTED, NO_ANSWER, FOLLOW_UP, MEMO, UPDATED, SCHEDULED, CANCELLED
  note                    String?
  nextFollowUpAt          DateTime? @db.Timestamptz(6)
  followUpCompletedAt     DateTime? @db.Timestamptz(6)
  createdByUserId         String?
  createdByName           String?
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([trialLeadId, createdAt])
  @@index([enrollmentApplicationId, createdAt])
  @@index([trialLeadId, nextFollowUpAt])
  @@index([enrollmentApplicationId, nextFollowUpAt])
}

// SMS 템플릿 — 상황별 자동 발송 메시지를 관리자가 편집/ON-OFF할 수 있는 시스템
model SmsTemplate {
  id              String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  trigger         String                  @unique // 트리거 코드 (TRIAL_NEW_ADMIN, TRIAL_CONFIRM_PARENT 등)
  name            String // 관리자에게 보여줄 이름 (예: "체험 신청 접수 — 관리자용")
  target          String // 수신 대상: ADMIN, COACH, PARENT
  body            String // 메시지 본문 (변수 포함: {{childName}} 등)
  isActive        Boolean                 @default(true) // ON/OFF 토글
  description     String? // 이 알림이 언제 발송되는지 설명
  variables       String? // 사용 가능한 변수 목록 (JSON: ["childName","parentName",...])
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  automationRules MessageAutomationRule[]
}

// 관리자 메시지 센터에서 이벤트별 자동 발송 여부와 채널 우선순위를 관리한다.
model MessageAutomationRule {
  id               String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  trigger          String       @unique
  name             String
  audienceScope    String // INTERNAL, EXTERNAL, SECURITY
  target           String
  isActive         Boolean      @default(true)
  requestedChannel String       @default("SMS") // AUTO, KAKAO_ALIMTALK, RCS, SMS, LMS, PUSH
  fallbackEnabled  Boolean      @default(true)
  fallbackChannel  String?      @default("SMS")
  templateId       String?
  description      String?
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  template         SmsTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([audienceScope, isActive])
  @@index([target, isActive])
  @@index([templateId])
}

// 내부·외부·보안 영역별로 사용할 발송 채널과 공급자 연결 정보를 관리한다.
model MessageChannelSetting {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  audienceScope   String // INTERNAL, EXTERNAL, SECURITY
  channel         String // KAKAO_ALIMTALK, RCS, SMS, LMS, PUSH
  provider        String   @default("SOLAPI")
  isEnabled       Boolean  @default(false)
  priority        Int      @default(100)
  fallbackChannel String?
  senderProfileId String?
  configJSON      Json?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([audienceScope, channel])
  @@index([audienceScope, isEnabled, priority])
}

// 방학특강 모집 단위. 한 시즌 안에 여러 특강 상품을 운영한다.
model SpecialProgramSeason {
  id                  String                      @id @default(dbgenerated("(gen_random_uuid())::text"))
  slug                String                      @unique
  title               String
  description         String?
  applicationOpensAt  DateTime                    @db.Timestamptz(6)
  applicationClosesAt DateTime                    @db.Timestamptz(6)
  startsAt            DateTime                    @db.Timestamptz(6)
  endsAt              DateTime                    @db.Timestamptz(6)
  status              String                      @default("DRAFT")
  termsText           String?
  cancellationPolicy  String?
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)
  offerings           SpecialProgramOffering[]
  applications        SpecialProgramApplication[]
  auditLogs           SpecialProgramAuditLog[]
  shuttleRoutePlans   ShuttleRoutePlan[]

  @@index([status, applicationOpensAt, applicationClosesAt])
}

model SpecialProgramOffering {
  id                     String                          @id @default(dbgenerated("(gen_random_uuid())::text"))
  seasonId               String
  code                   String
  title                  String
  description            String?
  targetGrades           String?
  instructorId           String?
  instructorName         String?
  location               String?
  capacity               Int?
  price                  Int
  newApplicantPrice      Int?
  existingApplicantPrice Int?
  shuttleAvailable       Boolean                         @default(false)
  shuttleFee             Int                             @default(0)
  status                 String                          @default("DRAFT")
  displayOrder           Int                             @default(0)
  linkedProgramId        String?
  linkedClassId          String?
  createdAt              DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                        @default(now()) @updatedAt @db.Timestamptz(6)
  season                 SpecialProgramSeason            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  sessionDates           SpecialProgramSessionDate[]
  applicationItems       SpecialProgramApplicationItem[]
  auditLogs              SpecialProgramAuditLog[]

  @@unique([seasonId, code])
  @@index([seasonId, status, displayOrder])
}

model SpecialProgramSessionDate {
  id         String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  offeringId String
  startsAt   DateTime               @db.Timestamptz(6)
  endsAt     DateTime               @db.Timestamptz(6)
  location   String?
  note       String?
  createdAt  DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  offering   SpecialProgramOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session    Session?

  @@unique([offeringId, startsAt])
  @@index([startsAt])
}

model SpecialProgramApplication {
  id                 String                          @id @default(dbgenerated("(gen_random_uuid())::text"))
  seasonId           String
  idempotencyKey     String
  applicantType      String?
  selectedWeekdays   String[]                        @default([])
  importSource       String?
  sourceRowRef       String?
  requiresReview     Boolean                         @default(false)
  reviewReasons      String[]                        @default([])
  childName          String
  childBirthDate     DateTime                        @db.Timestamptz(6)
  childGender        String?
  childGrade         String?
  childSchool        String?
  childPhone         String?
  parentName         String
  parentPhone        String
  parentRelation     String?
  address            String?
  memo               String?
  agreedTerms        Boolean                         @default(false)
  agreedPrivacy      Boolean                         @default(false)
  status             String                          @default("PENDING")
  totalPriceSnapshot Int
  convertedStudentId String?
  processedAt        DateTime?                       @db.Timestamptz(6)
  processedByUserId  String?
  processedNote      String?
  createdAt          DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                        @default(now()) @updatedAt @db.Timestamptz(6)
  season             SpecialProgramSeason            @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  items              SpecialProgramApplicationItem[]
  shuttleRequests    SpecialProgramShuttleRequest[]
  auditLogs          SpecialProgramAuditLog[]

  @@unique([seasonId, idempotencyKey])
  @@unique([seasonId, importSource, sourceRowRef])
  @@index([seasonId, requiresReview, createdAt])
  @@index([seasonId, status, createdAt])
  @@index([parentPhone, createdAt])
}

model SpecialProgramApplicationItem {
  id                      String                        @id @default(dbgenerated("(gen_random_uuid())::text"))
  applicationId           String
  offeringId              String
  priceSnapshot           Int
  tuitionPriceSnapshot    Int                           @default(0)
  siblingDiscountSnapshot Int                           @default(0)
  discountReasonSnapshot  String?
  shuttleFeeSnapshot      Int                           @default(0)
  titleSnapshot           String
  status                  String                        @default("PENDING")
  applicantFingerprint    String?
