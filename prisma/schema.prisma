model AcademySettings {
  id                          String   @id @default("singleton")
  introductionTitle           String?  @default("다산신도시 No.1 스티즈농구교실")
  introductionText            String?
  shuttleInfoText             String?
  contactPhone                String?
  address                     String?
  operatingHours              String?
  privacyPolicy               String?
  footerDescription           String?
  footerCopyright             String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  pageDesignJSON              String?
  googleCalendarIcsUrl        String?
  classDays                   String?
  siteBodyFont                String?  @default("system")
  siteHeadingFont             String?  @default("system")
  termsOfService              String?
  trialTitle                  String?  @default("체험수업 안내")
  trialContent                String?
  trialFormUrl                String?
  enrollTitle                 String?  @default("수강신청 안내")
  enrollContent               String?
  enrollFormUrl               String?
  googleSheetsScheduleUrl     String?
  youtubeUrl                  String?
  instagramUrl                String?
  instagramBusinessAccountId  String?
  instagramAutoPublishEnabled Boolean  @default(false)
  kakaoChannelUrl             String?
  philosophyText              String?
  facilitiesText              String?
  facilitiesImagesJSON        String?
  galleryImagesJSON           String? // 갤러리 이미지 목록(JSON 문자열)
  naverPlaceUrl               String? // 네이버 플레이스 리뷰 URL
  uniformFormUrl              String? // 유니폼 신청 구글폼 URL
  // ⚠️ 실 DB는 text 컬럼이고 'true'/'false' 문자열이 들어 있다(마이그레이션 없이
  //    admin.ts의 컬럼 자동 생성 fallback이 TEXT로 만든 흔적).
  //    Boolean으로 적어 두면 migrate가 불가능한 캐스팅(text→boolean)을 시도해 배포가 깨지므로
  //    스키마를 DB 현실에 맞춘다. 읽을 때는 queries.ts의 toBool이 안전하게 변환한다.
  useBuiltInTrialForm         String? // 'true'=자체 폼, 그 외=구글폼 외부 링크
  useBuiltInEnrollForm        String? // 'true'=자체 폼, 그 외=구글폼 외부 링크
  // 셔틀 노선의 출발지·도착지로 쓰는 학원 위치. 좌표가 text인 이유는
  // admin.ts의 컬럼 자동 생성 fallback이 TEXT로 만들었기 때문이다(읽는 쪽에서 Number 변환).
  academyPlaceName            String?
  academyAddress              String?
  academyLatitude             String?
  academyLongitude            String?
  shuttleDepotAddress         String? // 셔틀 차고지 주소(하루 운행 시작/종료 지점)
  shuttleDepotLatitude        Float?
  shuttleDepotLongitude       Float?
  shuttleHubName              String? // 무료 탑승 거점(예: 1호점) — 등원 탑승 지점
  shuttleHubAddress           String?
  shuttleHubLatitude          Float?
  shuttleHubLongitude         Float?
  shuttleHubDropoffName       String? // 무료 거점 하차 지점(길 건너 버스정류장 등, 탑승 거점과 다름)
  shuttleHubDropoffAddress    String?
  shuttleHubDropoffLatitude   Float?
  shuttleHubDropoffLongitude  Float?
  // 셔틀 확정 명단 킬 스위치. true=확정 명단 사용 / false·NULL=끔(항상 원본 조회, 전환 이전과 동일).
  // 원장이 재배포 없이 되돌릴 수 있어야 해서 환경변수가 아니라 DB에 둔다.
  shuttleRosterConfirmedMode  Boolean?
}

