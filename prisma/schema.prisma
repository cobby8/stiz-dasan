// 스태프 초대 링크 — 원장이 생성한 초대를 통해 스태프가 직접 가입
model StaffInvitation {
  id                  String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  token               String                       @unique @default(dbgenerated("(gen_random_uuid())::text")) // URL 토큰
  name                String // 초대 대상 이름
  phone               String // 초대 대상 전화번호 (하이픈 없이)
  role                Role                         @default(INSTRUCTOR) // 부여할 역할
  status              String                       @default("PENDING") // PENDING, PROCESSING, RECOVERY_REQUIRED, RECOVERING, ACCEPTED, CANCELLED, EXPIRED
  expiresAt           DateTime                     @db.Timestamptz(6) // 만료 시각
  acceptedAt          DateTime?                    @db.Timestamptz(6) // 수락 시각
  acceptedUserId      String? // 가입 완료된 User ID
  otpHash             String? // 인증번호 원문 대신 서버 비밀키 기반 HMAC 저장
  otpExpiresAt        DateTime?                    @db.Timestamptz(6) // 인증번호 만료 시각
  otpSentAt           DateTime?                    @db.Timestamptz(6) // 재발송 대기시간 계산 기준
  otpAttempts         Int                          @default(0) // 연속 인증 실패 횟수
  otpVerifiedAt       DateTime?                    @db.Timestamptz(6) // 전화번호 인증 완료 시각
  otpConsumedAt       DateTime?                    @db.Timestamptz(6) // 가입 처리에서 1회 사용 예약된 시각
  lockedAt            DateTime?                    @db.Timestamptz(6) // 실패 횟수 초과 잠금 시각
  processingAttemptId String? // 가입 처리 1회 실행 식별자
  processingStartedAt DateTime?                    @db.Timestamptz(6) // PROCESSING 진입 시각(자동 재사용 금지)
  recoveryOperationId String? // 운영 복구 실행 식별자(원 가입 시도와 분리)
  recoveryAuthUserId  String? // 보상 삭제 실패 시 운영 복구할 Auth 사용자 ID
  recoveryError       String? // 운영 복구에 필요한 오류 요약
  createdBy           String // 초대 생성자 (ADMIN User ID)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  otpSends            StaffInvitationOtpSend[]
  recoveryLogs        StaffInvitationRecoveryLog[]
  authAttempts        StaffInvitationAuthAttempt[]

  @@index([status])
  @@index([phone])
  @@index([phone, status])
}

model StaffInvitationOtpSend {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  invitationId String
  phoneHash    String
  requestHash  String
  status       String // RESERVED, SENT, FAILED, TIMEOUT
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  invitation   StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([phoneHash, createdAt])
  @@index([requestHash, createdAt])
}

model StaffInvitationRecoveryLog {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  invitationId String
  adminUserId  String
  action       String
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  invitation   StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
}

model StaffInvitationAuthAttempt {
  id           String          @id
  invitationId String
  authUserId   String?
  status       String
  error        String?
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  invitation   StaffInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([authUserId])
}

model StaffPhoneVerification {
  id             String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  ownerId        String
  phoneHash      String
  currentSendId  String?
  otpHash        String?
  otpExpiresAt   DateTime?                    @db.Timestamptz(6)
  attempts       Int                          @default(0)
  lockedAt       DateTime?                    @db.Timestamptz(6)
  lastSentAt     DateTime?                    @db.Timestamptz(6)
  status         String                       @default("PENDING")
  proofHash      String?
  proofExpiresAt DateTime?                    @db.Timestamptz(6)
  consumedAt     DateTime?                    @db.Timestamptz(6)
  createdAt      DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  sends          StaffPhoneVerificationSend[]

  @@unique([ownerId, phoneHash])
  @@index([ownerId, status])
  @@index([phoneHash, status])
}

model StaffPhoneVerificationSend {
  id             String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  verificationId String
  ownerId        String
  phoneHash      String
  status         String
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  verification   StaffPhoneVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([phoneHash, createdAt])
}

enum Role {
  ADMIN
  VICE_ADMIN
  INSTRUCTOR
  DRIVER
  PARENT
}

enum ShuttleRouteDirection {
  PICKUP
  DROPOFF
}

enum ShuttleRoutePlanStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  ARCHIVED
}

// ── 방학특강 출석·보강 개편 (2026-07) ──────────────────────────────
// 방학특강 수강일 — 학생(신청항목)이 오기로 한 특정 회차(날짜). 날짜별 명단·정원·보강의 단일 기준.
model SpecialProgramEnrollmentDate {
  id                        String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  applicationItemId         String // SpecialProgramApplicationItem.id (정규 수강 항목)
  offeringId                String // 스코프/조회 편의
  sessionDateId             String // SpecialProgramSessionDate.id (어느 특정 날짜)
  studentId                 String? // 전환된 Student.id (있으면)
  kind                      String                 @default("REGULAR") // REGULAR | MAKEUP
  status                    String                 @default("SCHEDULED") // SCHEDULED | CANCELLED | MOVED
  makeupId                  String? // 이 행이 보강으로 생성됐다면 SpecialProgramMakeup.id
  attendanceStatus          String? // null(미확인) | PRESENT | LATE | ABSENT | EXCUSED
  arrivedAt                 DateTime?              @db.Timestamptz(6)
  attendanceNote            String?
  attendanceCheckedAt       DateTime?              @db.Timestamptz(6)
  attendanceCheckedByUserId String?
  createdAt                 DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @updatedAt @db.Timestamptz(6)
  absence                   SpecialProgramAbsence? // 사전 결석 신고(back-relation, 좌석당 1건)

  @@unique([applicationItemId, sessionDateId])
  @@index([sessionDateId, status])
  @@index([offeringId])
  @@index([studentId])
  @@index([makeupId])
}

// 방학특강 셔틀 "확정 명단". 원장이 한 번 확인해 확정한 탑승 명단을 값으로 복제해 보관한다.
// 모든 셔틀 화면은 원본 4테이블을 다시 조인하지 않고 이 표(또는 게이트웨이의 폴백)만 본다.
//
// ⚠️ 원본에 FK를 걸지 않는다. 원본 신청이 지워질 때 확정본이 같이 죽으면 존재 이유가 무너진다.
//    (같은 관례: SpecialProgramEnrollmentDate)
// ⚠️ 하드 DELETE 금지. 제외는 removedAt/removedReason 으로 남긴다.
// 날짜별 명단은 저장하지 않는다 — 확정본 × SpecialProgramEnrollmentDate(SCHEDULED)로 파생한다.
// DDL: prisma/sql/add_seasonal_shuttle_roster.sql (prisma migrate dev 금지)
model SeasonalShuttleRoster {
  id                String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  seasonId          String
  shuttleRequestId  String
  applicationItemId String?

  studentIdSnapshot   String? // 전환된 Student.id (학부모 마이페이지가 자녀와 잇는 열쇠)
  studentNameSnapshot String
  childGradeSnapshot  String?
  childGenderSnapshot String?
  childPhoneSnapshot  String?
  parentNameSnapshot  String?
  parentPhoneSnapshot String?

  offeringIdSnapshot       String?
  offeringTitleSnapshot    String?
  weekdaysSnapshot         Json?
  classStartSnapshot       String? // 'HH:MM' (Asia/Seoul)
  classEndSnapshot         String?
  requestCreatedAtSnapshot DateTime? @db.Timestamptz(6) // 미배정 목록의 기존 정렬(신청순) 재현용

  // 탑승 여부. 원본 status(REQUESTED/ASSIGNED/CANCELLED)와 분리해 토글 충돌을 없앤다.
  ride Boolean @default(true)

  pickupLocation       String?
  pickupAddress        String?
  pickupRoadAddress    String?
  pickupLatitude       Float?
  pickupLongitude      Float?
  pickupPlaceId        String?
  pickupLocationSource String?
  pickupAccuracyMeters Float?
  // 관리자 위치 확인 시각. 노선 편성 화면의 "배차 가능" 판정에 쓰이므로 반드시 복제한다.
  pickupConfirmedAt    DateTime? @db.Timestamptz(6)
  pickupTime           String? // 학부모 희망시간(참고값). 형식이 제각각이라 계산에 쓰지 않는다.

  dropoffLocation       String?
  dropoffAddress        String?
  dropoffRoadAddress    String?
  dropoffLatitude       Float?
  dropoffLongitude      Float?
  dropoffPlaceId        String?
  dropoffLocationSource String?
  dropoffAccuracyMeters Float?
  dropoffConfirmedAt    DateTime? @db.Timestamptz(6)
  dropoffSameAsPickup   Boolean   @default(false)

  sourceFingerprint String? // 확정 시점 원본 값의 md5. 4단계 변동 감지가 이걸로 비교한다.
  confirmedAt       DateTime  @default(now()) @db.Timestamptz(6)
  confirmedByUserId String?
  removedAt         DateTime? @db.Timestamptz(6)
  removedReason     String?
  note              String?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([seasonId, shuttleRequestId], map: "SeasonalShuttleRoster_season_request_key")
  @@index([seasonId, ride, removedAt], map: "SeasonalShuttleRoster_season_ride_removed_idx")
  @@index([applicationItemId], map: "SeasonalShuttleRoster_applicationItem_idx")
}

// 방학특강 보강 — 결석(absentSessionDate) ↔ 보강대상(특강 다른 날짜 SEASONAL / 정규수업 REGULAR).
// 학부모 신청(REQUESTED) → 관리자 승인(APPROVED/SCHEDULED). 규칙: 결석일+2개월 이내, 보강≤결석, 정원 12 미만.
model SpecialProgramMakeup {
  id                  String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  applicationItemId   String // 결석한 원 수강 항목
  studentId           String?
  offeringId          String
  absentSessionDateId String // 결석한 특강 날짜
  targetType          String    @default("SEASONAL") // SEASONAL | REGULAR
  targetSessionDateId String? // (SEASONAL) 보강 대상 특강 날짜
  targetClassId       String? // (REGULAR) 정규수업 반
  targetSessionId     String? // (REGULAR) 정규수업 세션(있으면)
  targetDate          DateTime? @db.Timestamptz(6) // (REGULAR) 정규수업 날짜
  status              String    @default("REQUESTED") // REQUESTED | APPROVED | SCHEDULED | ATTENDED | CANCELLED | REJECTED | NO_SHOW
  requestedBy         String    @default("PARENT") // PARENT | ADMIN
  requestedByUserId   String?
  approvedByUserId    String?
  requestedAt         DateTime  @default(now()) @db.Timestamptz(6)
  decidedAt           DateTime? @db.Timestamptz(6)
  note                String?
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([offeringId, status])
  @@index([absentSessionDateId])
  @@index([applicationItemId])
  @@index([studentId])
  @@index([status, requestedAt])
}

// 방학특강 사전 결석 신고 — 좌석(SpecialProgramEnrollmentDate) 당 1건(@unique).
// 학부모 앱/관리자가 결석을 미리 신고하고, 관리자가 보강/이월/환불로 처리한다.
// enum 대신 기존 컨벤션(String 컬럼 + 주석 + 앱검증)을 따른다(attendanceStatus·status 등과 동일).
//   사유(reason):     ILLNESS_INJURY | PERSONAL | FAMILY_TRIP | SCHOOL_EVENT | ETC
//   처리(resolution): PENDING | MAKEUP | CARRYOVER | REFUND
//   상태(status):     REPORTED | CONFIRMED | CANCELLED
// DDL: prisma/migrations/20260727130000_add_seasonal_absence_credit (prisma migrate dev 금지 — 운영은 직접 적용)
model SpecialProgramAbsence {
  id               String                       @id @default(dbgenerated("(gen_random_uuid())::text"))
  enrollmentDateId String                       @unique // 좌석당 신고 1건
  reason           String // ILLNESS_INJURY | PERSONAL | FAMILY_TRIP | SCHOOL_EVENT | ETC
  resolution       String                       @default("PENDING") // PENDING | MAKEUP | CARRYOVER | REFUND
  status           String                       @default("REPORTED") // REPORTED | CONFIRMED | CANCELLED
  note             String?
  reportedByUserId String? // 신고한 학부모 앱 계정
  resolvedByUserId String? // 처리한 관리자
  createdAt        DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                     @default(now()) @updatedAt @db.Timestamptz(6)
  enrollmentDate   SpecialProgramEnrollmentDate @relation(fields: [enrollmentDateId], references: [id], onDelete: Cascade)
  credit           SpecialProgramCredit? // 이월 처리 시 파생된 크레딧(back-relation)

  @@index([status], map: "SpecialProgramAbsence_status_idx")
}

// 방학특강 이월 크레딧 원장 — 결석을 '이월(CARRYOVER)'로 처리할 때 발생하는 금액 원장.
// 어느 수강 항목(applicationItem)에 얼마(amount, 원)가 쌓였고, 어느 결석에서 나왔는지(sourceAbsence) 추적.
//   상태(status): ACTIVE(사용가능) | USED(사용됨) | REFUNDED(환불됨)
// DDL: prisma/migrations/20260727130000_add_seasonal_absence_credit (prisma migrate dev 금지 — 운영은 직접 적용)
model SpecialProgramCredit {
  id                String                        @id @default(dbgenerated("(gen_random_uuid())::text"))
  applicationItemId String // 크레딧이 귀속되는 수강 항목
  amount            Int // 금액(원, KRW)
  sourceAbsenceId   String?                       @unique // 이 크레딧이 파생된 결석(있으면). 결석 1건당 크레딧 1건
  status            String                        @default("ACTIVE") // ACTIVE | USED | REFUNDED
  note              String?
  createdByUserId   String?
  createdAt         DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                      @default(now()) @updatedAt @db.Timestamptz(6)
  applicationItem   SpecialProgramApplicationItem @relation(fields: [applicationItemId], references: [id], onDelete: Cascade)
  sourceAbsence     SpecialProgramAbsence?        @relation(fields: [sourceAbsenceId], references: [id], onDelete: SetNull)

  @@index([applicationItemId], map: "SpecialProgramCredit_applicationItem_idx")
  @@index([status], map: "SpecialProgramCredit_status_idx")
}

// 정규 수업 "사전 결석 신고" — 정규반은 미래 회차 좌석(SpecialProgramEnrollmentDate 같은)이 없어,
//   결석 신고 자체를 (학생 × 반 × 날짜) 레코드로 둔다.
//   방학특강 결석(SpecialProgramAbsence)과 동일한 reason 코드값을 쓰되, resolution(보강/이월/환불) 개념은
//   MVP 범위 밖이라 넣지 않는다(추후 확장). enum 대신 기존 컨벤션(TEXT + 앱검증)을 따른다.
//     reason: ILLNESS_INJURY | PERSONAL | FAMILY_TRIP | SCHOOL_EVENT | ETC
//     status: REPORTED(기본) | CONFIRMED | CANCELLED
// DDL: prisma/migrations/20260727140000_add_regular_absence/migration.sql (prisma migrate dev 금지 — 운영은 직접 적용)
model RegularAbsence {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId        String // 결석 학생
  classId          String // 결석 반(정규)
  date             DateTime @db.Date // 결석 날짜(날짜 단위 — 시간 없음)
  reason           String // ILLNESS_INJURY | PERSONAL | FAMILY_TRIP | SCHOOL_EVENT | ETC
  status           String   @default("REPORTED") // REPORTED | CONFIRMED | CANCELLED
  note             String?
  reportedByUserId String? // 신고한 학부모 앱 계정
  resolvedByUserId String? // 처리한 관리자
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class            Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date]) // 학생·반·날짜당 신고 1건
  @@index([classId, date], map: "RegularAbsence_classId_date_idx") // 기사/관리자 날짜별 조회
  @@index([status], map: "RegularAbsence_status_idx")
}

// 저장된 배차 노선 — 원장이 자동 제안을 손으로 조정한 뒤 저장한 결과(날짜×방향 1행).
// 상세 근거는 prisma/migrations/20260726160000_add_seasonal_dispatch_route/migration.sql 참고.
model SeasonalDispatchRoute {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  serviceDate   String // 'YYYY-MM-DD'
  direction     String // 'PICKUP' | 'DROPOFF'
  payload       Json // 조정된 vehicles 스냅샷
  classStart    String?
  classEnd      String?
  savedByUserId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([serviceDate, direction])
}

// 정규 배차 "저장된 노선" — 방학특강 SeasonalDispatchRoute의 요일판.
// 정규는 상시 요일 운영이라 특정 날짜가 아니라 '요일(Mon~Sun) × 방향' 단위로 1행 저장한다.
// 상세 근거는 prisma/migrations/20260727120000_add_regular_dispatch_route/migration.sql 참고.
model RegularDispatchRoute {
  id            String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  serviceMonth  String   @default("2026-09") // 'YYYY-MM' — 월별 차량표 스냅샷
  dayOfWeek     String // 'Mon' | 'Tue' | 'Wed' | 'Thu' | 'Fri' | 'Sat' | 'Sun'
  direction     String // 'PICKUP' | 'DROPOFF'
  payload       Json // 조정된 vehicles 스냅샷(정차 순서·시각·경로 포함)
  classStart    String? // SeasonalDispatchRoute와 동일 String
  classEnd      String? // SeasonalDispatchRoute와 동일 String
  savedByUserId String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([serviceMonth, dayOfWeek, direction]) // 월·요일·방향당 저장 1건
}

// 기사님 전용 링크 — 토큰 → (날짜×방향). 상세: prisma/migrations/20260727000000_add_shuttle_run_link_and_boarding
model ShuttleRunLink {
  id              String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  token           String   @unique
  serviceDate     String
  direction       String
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([serviceDate, direction])
}

// 셔틀 탑승/미탑승 기록 — (날짜×방향×셔틀신청) 1행.
model ShuttleBoarding {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  serviceDate      String
  direction        String
  shuttleRequestId String
  studentName      String?
  status           String // 'BOARDED' | 'NOSHOW'
  checkedVia       String?
  checkedAt        DateTime @default(now())

  @@unique([serviceDate, direction, shuttleRequestId])
}

// 기사님 → 관리자 변경 요청. 기사 화면에서 학생 제외·주소 변경·순서 고정·기타를 요청하면
// 관리자가 배차 화면에서 승인·거절한다. 승인 시 type에 따라 자동으로 명단·노선이 수정된다.
model DriverRequest {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  token            String
  serviceDate      String
  type             String // 'REMOVE' | 'LOCATION' | 'ORDER' | 'OTHER'
  targetId         String? // REMOVE: shuttleRequestId, ORDER: "${dir}:${vehicleIdx}"
  targetName       String? // 학생 or 정류장 이름 스냅샷
  note             String?
  payload          Json? // ORDER: [{label,lat,lng,...}] 새 순서 배열
  status           String    @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  resolvedAt       DateTime? @db.Timestamptz(6)
  resolvedByUserId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([token, serviceDate])
}

// 기사님 실시간 GPS 위치 — token당 1행(현재 위치만 유지, 히스토리 없음).
// 기사님 화면에서 위치 공유 ON 상태일 때 10초마다 갱신한다.
// FK는 DB 레벨(migration.sql)에만 있고 Prisma relation은 정의하지 않는다(raw query 전용).
model DriverLocation {
  token     String   @id
  label     String?
  latitude  Float
  longitude Float
  accuracy  Float?
  speed     Float?
  heading   Float?
  sharing   Boolean  @default(true)
  updatedAt DateTime @db.Timestamptz(6)
}

// 정규 수업 셔틀 운행리스트(구글 시트 이관본). 요일별 하루 타임라인의 정차 하나 = 1행.
model RegularShuttleStop {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  serviceMonth String   @default("2026-09") // 'YYYY-MM' — 가져온 차량 시트의 적용 월
  weekday      Int
  classTime    String?
  arriveTime   String?
  stopName     String
  direction    String // 'BOARD'|'ALIGHT'|'PIVOT'|'RETURN'
  studentName  String?
  studentId    String? // 월별 시트 이관 시 확정한 안정적인 학생 식별값
  studentPhone String?
  parentPhone  String?
  note         String?
  sortOrder    Int      @default(0)
  latitude     Float?
  longitude    Float?
  importedAt   DateTime @default(now())
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([serviceMonth, weekday, sortOrder])
  @@index([studentId, serviceMonth])
}

// 정규 차량 변동 문자의 승인·발송 상태. 일반 NotificationDelivery의 전송 상태와 분리한다.
model RegularShuttleNoticeBatch {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  serviceMonth     String
  compareMonth     String
  stableEventKey   String
  payloadHash      String    @unique
  studentId        String
  studentName      String
  recipientPhone   String
  messageBody      String
  beforeText       String?
  afterText        String
  status           String    @default("HELD") // HELD | APPROVED | SENDING | SENT | CANCELLED | UNCERTAIN
  approvedByUserId String?
  approvedAt       DateTime? @db.Timestamptz(6)
  sentAt           DateTime? @db.Timestamptz(6)
  errorCode        String?
  lockedAt         DateTime? @db.Timestamptz(6)
  createdByUserId  String
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([stableEventKey, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// 예약 발송 대기열 — "보낼 문자를 미리 얼려 두는" 큐.
//
// 왜 문안을 통째로 저장하는가(참조가 아니라 값):
//   발송 시각이 되었을 때 노선을 다시 읽어 문안을 만들면, 그 사이 노선이 바뀐 경우
//   **원장이 검토한 것과 다른 문자가 학부모에게 나간다**. 회수가 불가능하므로
//   예약을 거는 순간의 문안·수신번호를 값으로 복제해 둔다.
model ScheduledMessage {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  // 묶음 식별자(한 번의 예약 = 여러 행). 취소·조회 단위.
  batchKey  String
  // 보낼 시각(UTC 저장). 크론이 이 시각을 지난 PENDING 행만 집는다.
  sendAt    DateTime  @db.Timestamptz(6)
  recipient String
  body      String
  // 화면 표시·중복 방지용 라벨(학생 이름 등). 발송 내용에는 쓰지 않는다.
  label     String?
  // PENDING | SENT | FAILED | CANCELLED
  status    String    @default("PENDING")
  // sendManualSms에 넘길 멱등 키. 같은 행이 두 번 발송되지 않게 한다.
  requestId String
  purpose   String?
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime? @db.Timestamptz(6)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([status, sendAt])
  @@index([batchKey])
}

// 보강권 — 결석 1회당 1장 발급되어, 학부모가 다른 반에 보강 예약할 때 사용한다.
//
// 왜 MakeupSession 과 따로 두는가:
//   MakeupSession 은 "언제 어느 반에 보강 간다"는 **예약 기록**이다.
//   그런데 약관은 "결석하면 권리가 생기고, 2개월 지나면 소멸한다"는 **권리**를 규정한다.
//   예약 전에도 존재하고 예약 없이 소멸할 수 있으므로 별도 개념이어야 한다.
//   (예약만 보면 "쓰지 않은 보강권이 몇 장 남았는지"를 알 수 없다.)
//
// 약관 근거(2026-08-09 개정):
//   · 결석 1회당 보강권 1회 발급
//   · 결석이 발생한 날로부터 2개월 이내 사용, 지나면 자동 소멸
//   · 예약 후 무단 불참 시 사용한 것으로 처리
//   · 미리 취소하면 보강권 유지
model MakeupCredit {
  id        String @id @default(dbgenerated("(gen_random_uuid())::text"))
  studentId String

  // REGULAR(정규 수업) | SEASONAL(방학특강)
  sourceType String

  // 중복 발급 방지용 자연키. 출결을 껐다 켜도 한 결석에 한 장만 나가게 한다.
  //   정규     REGULAR:{classId}:{YYYY-MM-DD}
  //   방학특강 SEASONAL:{enrollmentDateId}
  sourceKey String

  // 결석일 — 만료 계산의 기준점이다(발급일이 아니다. 약관: "결석이 발생한 날로부터").
  absenceDate DateTime @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)

  // 어디서 나온 결석인가(출처 추적용, 화면 표시에도 쓴다)
  originClassId   String? // 정규 수업 반
  originItemId    String? // 방학특강 수강항목
  originSessionId String? // 정규 Session / 방학특강 SpecialProgramSessionDate

  // AVAILABLE 사용가능 | RESERVED 예약됨 | USED 사용완료 | NO_SHOW 무단불참(차감)
  // | EXPIRED 기간만료 | REVOKED 회수(결석이 취소된 경우)
  status String @default("AVAILABLE")

  // 사용 시 연결되는 예약 기록
  makeupSessionId String?

  note      String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  // 한 결석에 보강권은 한 장뿐이다.
  @@unique([studentId, sourceKey])
  @@index([studentId, status])
  @@index([status, expiresAt]) // 만료 처리 크론이 쓰는 인덱스
  @@index([makeupSessionId])
}

/// 토스POS ↔ 사이트 결제 대사 실행 기록.
/// Vercel 은 실행마다 파일이 사라져 결과를 파일로 못 남긴다. 관리자 화면이 읽는 원본이다.
/// 이 표는 기록만 담는다 — 청구서·결제를 바꾸는 값은 들어가지 않는다.
model PosReconcileRun {
  id             String    @id @default(dbgenerated("gen_random_uuid()::text"))
  targetMonth    String // 'YYYY-MM' (DB CHECK 제약으로 형식 고정)
  status         String    @default("OK") // OK | FAILED
  error          String?
  source         String    @default("CRON") // CRON | MANUAL
  siteCount      Int       @default(0)
  siteAmount     BigInt    @default(0)
  posCount       Int       @default(0)
  posAmount      BigInt    @default(0)
  matchedCount   Int       @default(0)
  heldCount      Int       @default(0)
  siteOnlyCount  Int       @default(0)
  posOnlyCount   Int       @default(0)
  diffAmount     BigInt    @default(0)
  /// 대조표 전문. 화면에서 다시 계산하지 않는다.
  reportMarkdown String?
  startedAt      DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([targetMonth, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

/// 토스플레이스 웹훅 수신 기록. 받은 사실만 남긴다(청구서·결제는 건드리지 않는다).
/// webhookId 가 유일값인 것이 중복 처리 방지의 핵심 — 토스는 2xx 를 못 받으면 같은 알림을 다시 보낸다.
model PosWebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  /// x-toss-webhook-id — 재시도해도 같은 값이라 중복 판별의 기준이 된다
  webhookId   String    @unique
  /// x-toss-delivery-id — 재시도마다 바뀐다
  deliveryId  String?
  eventId     String?
  eventType   String?
  merchantId  String?
  payload     Json
  status      String    @default("RECEIVED") // RECEIVED | IGNORED | MATCHED | HELD
  note        String?
  receivedAt  DateTime  @default(now()) @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)

  @@index([receivedAt(sort: Desc)])
  @@index([eventType, receivedAt(sort: Desc)])
}

/// 토스POS 결제 1건 = 슬랙 DM 1통 (migration 20260930090000_add_pos_payment_notice 의 사본)
/// 랠리즈가 청구서 원본이다. POS 결제마다 "랠리즈에서 현장결제 처리하셨나요?" 를 묻고 답을 남긴다.
/// ⚠️ DB 에는 부분 유일 인덱스("sitePaymentId" WHERE "siteMarkedPaid" = true)가 더 있다.
///    Prisma 로 표현할 수 없어 여기에 적지 않는다(적으면 반대 방향으로 어긋난다).
model PosPaymentNotice {
  id                 String    @id @default(dbgenerated("gen_random_uuid()::text"))
  /// 토스 결제 ID — 주문·결제 알림이 둘 다 와도 DM 은 한 통(중복 판별 기준)
  tossPaymentId      String    @unique
  tossOrderId        String
  amount             BigInt
  approvedAt         DateTime? @db.Timestamptz(6)
  lineItems          String?
  memo               String?
  resolvedStudentId  String?
  targetYear         Int?
  targetMonth        Int?
  sitePaymentId      String?
  kind               String // AUTO_CANDIDATE | NO_MEMO | AMBIGUOUS | NOT_IN_ROSTER | NO_SITE_INVOICE | ALREADY_PAID | AMOUNT_MISMATCH
  pickedKind         String? // 원장이 원생을 고른 뒤의 분류(AUTO_CANDIDATE | NO_SITE_INVOICE | ALREADY_PAID | AMOUNT_MISMATCH)
  status             String    @default("PENDING") // PENDING | NOTIFIED | STUDENT_CHOSEN | CONFIRMED | IGNORED | FAILED
  slackChannel       String?
  slackTs            String?
  error              String?
  decidedBySlackUser String?
  decidedAt          DateTime? @db.Timestamptz(6)
  siteMarkedPaid     Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@index([tossOrderId])
}

/// 카카오 정책 답변 — 정책 문서 버전 이력 (migration 20261009120000_add_kakao_policy_qa 의 사본)
/// 저장할 때마다 한 줄 추가한다. 가장 최근 행이 현재 문서다.
/// ⚠️ DB 에는 content 길이 CHECK(30000자)가 더 있다.
model KakaoPolicyDocumentVersion {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  content      String
  editorUserId String?
  editorName   String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
}

/// 카카오 정책 답변 켜기/끄기(킬 스위치). 행은 id='default' 하나뿐이고 기본값은 꺼짐.
model KakaoPolicyQaSetting {
  id              String   @id @default("default")
  enabled         Boolean  @default(false)
  updatedByUserId String?
  updatedByName   String?
  updatedAt       DateTime @default(now()) @db.Timestamptz(6)
}

/// 카카오 정책 답변 기록. 사용자키는 해시만, 전화번호는 저장하지 않는다. 180일 뒤 data-retention 크론이 지운다.
model KakaoPolicyQaLog {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  question    String   @db.VarChar(500)
  answer      String?
  outcome     String // ANSWERED | ESCALATE | TIMEOUT | ERROR
  mode        String // SYNC | CALLBACK
  linked      Boolean
  latencyMs   Int
  userKeyHash String
  callbackOk  Boolean?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([userKeyHash, createdAt(sort: Desc)])
  @@index([createdAt], map: "KakaoPolicyQaLog_createdAt_asc_idx")
}
