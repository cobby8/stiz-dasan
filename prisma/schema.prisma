  paymentId               String?
  conversionStatus        String                        @default("NOT_STARTED")
  conversionError         String?
  createdAt               DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                      @default(now()) @updatedAt @db.Timestamptz(6)
  application             SpecialProgramApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  offering                SpecialProgramOffering        @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  shuttleRequest          SpecialProgramShuttleRequest?
  auditLogs               SpecialProgramAuditLog[]
  credits                 SpecialProgramCredit[] // 이월 크레딧 원장(back-relation, 추가 전용)

  @@unique([applicationId, offeringId])
  @@index([offeringId, status])
  @@index([offeringId, applicantFingerprint])
  @@index([offeringId, waitlistOrder])
}

model ParentSignupVerification {
