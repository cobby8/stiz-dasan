  failedAt            DateTime?             @db.Timestamptz(6)
  errorCode           String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamptz(6)
  batch               MessageDeliveryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([batchId, status, createdAt])
  @@index([source, status, createdAt])
  @@index([recipientPhoneHash, createdAt])
  @@index([recipientPhoneLast4, createdAt])
  @@index([stableEventKey, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([sessionId, eventType])
  @@index([recipientUserId, createdAt])
  @@index([trigger, audienceScope, status, createdAt])
  @@index([requestedChannel, createdAt])
  @@index([provider, providerMessageId])
  @@index([provider, providerGroupId])
}

