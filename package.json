{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "prisma generate && next build --webpack",
    "build:vercel": "node scripts/regular-shuttle-db-preflight.mjs && node scripts/operations-sync-db-preflight.mjs && node scripts/uniform-order-db-preflight.mjs && node scripts/kakao-parent-db-preflight.mjs && npm run build",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:code-check": "node scripts/release-preflight.mjs --skip-env",
    "payments:preflight": "dotenv -e .env.local -e .env -- node scripts/payment-preflight.mjs",
    "seasonal:import:dry-run": "node scripts/seasonal-import.mjs",
    "test": "npm run test:guards && node --test \"tests/*.test.mjs\"",
    "test:guards": "node --experimental-strip-types --test src/lib/studentVisibility.test.ts",
    "test:seasonal-import":"node --test scripts/seasonal-import.test.mjs",
    "db:push": "prisma db push",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@craftjs/core": "^0.2.12",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-dropcursor": "^3.20.0",
    "@tiptap/extension-font-family": "^3.20.0",
    "@tiptap/extension-image": "^3.20.0",
    "@tiptap/extension-table": "^3.20.0",
    "@tiptap/extension-text-align": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/extension-youtube": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "driver.js": "^1.4.0",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.575.0",
    "lzutf8": "^0.6.3",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "node-ical": "^0.25.4",
    "re-resizable": "^6.11.2",
    "react": "19.2.3",
    "react-contenteditable": "^3.3.7",
    "react-dom": "19.2.3",
    "react-image-crop": "^11.0.10",
    "react-rnd": "^10.5.2",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
