<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.attachments" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/attachment_paths" />
        </provider>
        <!-- adjustResize: 화면 끝까지 그리지 않는 폰(Android 14 이하)은 키보드만큼 창이 줄어들고, 이때 앱이 받는 키보드 여백은 0 이라
             MainActivity 의 키보드 여백과 겹치지 않는다. 화면 끝까지 그리는 폰(15 이상)은 창이 안 줄어 앱이 키보드 여백을 직접 준다. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <!-- 앱 링크(2026-11-13 원장 승인): 문자·카카오톡 속 www.stiz-dasan.kr 링크를 누르면 브라우저 대신 이 앱이 바로 열린다.
                 autoVerify=true 는 사이트의 /.well-known/assetlinks.json(src/app/api/assetlinks/route.ts)으로 주인 확인을 받는다.
                 확인 전·실패 시에는 그냥 브라우저로 열린다(앱이 깨지지 않음).
                 ⚠️ 일부러 좁게 정한다. 토스가 결제 후 돌려보내는 주소(/payments/success·/payments/fail·/mypage/payments/done)까지
                 잡으면 웹에서 결제하던 학부모의 결제 확인이 앱으로 튀어 끊길 수 있다. 그래서 청구서는 «번호(UUID, 하이픈 4개) 모양»만,
                 마이페이지는 정확히 /mypage 와 /mypage/payments 만 받는다. 아이폰 목록은 src/lib/app-site-association.ts 와 같게 유지. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.stiz-dasan.kr" />
                <data android:pathPrefix="/driver/" />
                <data android:pathPattern="/payments/.*-.*-.*-.*-.*" />
                <data android:path="/mypage" />
                <data android:path="/mypage/payments" />
                <data android:path="/login" />
                <data android:path="/store-app" />
            </intent-filter>
        </activity>
        <service android:name=".DriverLocationService" android:exported="false" android:foregroundServiceType="location" android:stopWithTask="false" />
        <!-- 앱 알림(FCM, 2026-11-14 e2): 학원 알림을 받아 알림줄에 띄운다. Firebase 설정 없이 빌드하면 아무것도 받지 않는다. -->
        <service android:name=".StizMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT" /></intent-filter>
        </service>
    </application>
</manifest>
